FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

RUN corepack enable pnpm

COPY . .

RUN pnpm install --frozen-lockfile

RUN git fetch https://github.com/unocss/unocss.git --tags

RUN pnpm -w run deploy

FROM ikxin/caddy:latest

COPY --from=builder /app/docs/dist /usr/share/caddy

EXPOSE 8080
