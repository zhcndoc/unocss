FROM --platform=$BUILDPLATFORM node:24-bookworm AS build

RUN npm install --global pnpm@12.11.2

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm -w run deploy

FROM caddy:2-alpine

COPY --from=build /app/docs/dist /srv

COPY <<'EOF' /etc/caddy/Caddyfile
:80 {
    root * /srv
    encode zstd gzip

    try_files {path} {path}.html
    file_server

    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
}
EOF

EXPOSE 80
